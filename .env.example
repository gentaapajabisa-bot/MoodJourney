# Salin nilai ini ke Vercel > Project > Settings > Environment Variables
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxx.root
DB_PASSWORD=isi_password_anda
DB_NAME=moodjourney
DB_SSL=1

# --- Opsional ---
# Zona waktu aplikasi (default Asia/Jakarta)
APP_TZ=Asia/Jakarta
# Alamat situs, dipakai untuk link di email reset password (tanpa garis miring di akhir)
APP_URL=https://nama-proyek-anda.vercel.app
# Kirim email reset password otomatis lewat Resend (https://resend.com). Tanpa ini,
# reset password dilakukan admin lewat panel admin.
RESEND_API_KEY=
MAIL_FROM=MoodJourney <noreply@domain-anda.com>
# Rahasia untuk Vercel Cron (pengingat email harian). Isi dengan teks acak yang panjang.
# Vercel otomatis mengirimnya saat memanggil /cron/reminder.php
CRON_SECRET=
# Set 1 untuk menampilkan pesan error lengkap saat debugging (jangan dipakai permanen)
APP_DEBUG=0
