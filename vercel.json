{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php?_r=$1"
    }
  ],
  "crons": [
    {
      "path": "/cron/reminder.php",
      "schedule": "0 13 * * *"
    }
  ]
}
